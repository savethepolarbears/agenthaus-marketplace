{
  "_comment": "Add mcpServers entries to your ~/.codeium/windsurf/mcp_config.json",
  "mcpServers": {
    "notion": {
      "args": [
        "-y",
        "@modelcontextprotocol/server-notion"
      ],
      "command": "npx",
      "env": {
        "NOTION_API_KEY": "${env:NOTION_API_KEY}"
      }
    }
  }
}
