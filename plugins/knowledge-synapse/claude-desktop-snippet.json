{
  "_comment": "Paste the \"mcpServers\" entries below into your claude_desktop_config.json",
  "_plugin": "knowledge-synapse",
  "_version": "1.2.0",
  "mcpServers": {
    "context7": {
      "args": [
        "-y",
        "@upstash/context7-mcp@4.5.1"
      ],
      "command": "npx",
      "env": {
        "CONTEXT7_API_KEY": "${CONTEXT7_API_KEY}"
      }
    },
    "notion": {
      "type": "http",
      "url": "https://mcp.notion.com/mcp"
    }
  }
}
