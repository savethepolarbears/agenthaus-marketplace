{
  "_comment": "Add mcpServers entries to your Gemini CLI settings",
  "mcpServers": {
    "context7": {
      "args": [
        "-y",
        "@upstash/context7-mcp@4.5.1"
      ],
      "command": "npx",
      "env": {
        "CONTEXT7_API_KEY": "${CONTEXT7_API_KEY}"
      }
    },
    "notion": {
      "httpUrl": "https://mcp.notion.com/mcp"
    }
  }
}
