{
  "_comment": "Paste the \"mcpServers\" entries below into your claude_desktop_config.json",
  "_plugin": "cloudflare-platform",
  "_version": "1.1.0",
  "mcpServers": {
    "cloudflare": {
      "headers": {
        "Authorization": "Bearer ${CLOUDFLARE_API_TOKEN}"
      },
      "type": "http",
      "url": "https://mcp.cloudflare.com/mcp"
    }
  }
}
