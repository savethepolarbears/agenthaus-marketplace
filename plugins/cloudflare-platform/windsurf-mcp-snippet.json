{
  "_comment": "Add mcpServers entries to ~/.config/devin/mcp_config.json (legacy Windsurf: ~/.codeium/windsurf/mcp_config.json)",
  "mcpServers": {
    "cloudflare": {
      "headers": {
        "Authorization": "Bearer ${env:CLOUDFLARE_API_TOKEN}"
      },
      "type": "http",
      "url": "https://mcp.cloudflare.com/mcp"
    }
  }
}
