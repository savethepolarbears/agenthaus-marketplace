{
  "mcpServers": {
    "encharge": {
      "command": "npx",
      "args": [
        "tsx",
        "${CLAUDE_PLUGIN_ROOT}/node_modules/encharge-cli/src/mcp/index.ts"
      ],
      "env": {
        "ENCHARGE_API_KEY": "${ENCHARGE_API_KEY}",
        "ENCHARGE_ACCOUNTS": "${ENCHARGE_ACCOUNTS}",
        "ENCHARGE_WORKSPACE_CONFIG": "${ENCHARGE_WORKSPACE_CONFIG}",
        "ENCHARGE_DEFAULT_ACCOUNT": "${ENCHARGE_DEFAULT_ACCOUNT}"
      }
    }
  }
}
