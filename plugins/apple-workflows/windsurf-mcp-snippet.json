{
  "_comment": "Add mcpServers entries to ~/.config/devin/mcp_config.json (legacy Windsurf: ~/.codeium/windsurf/mcp_config.json)",
  "mcpServers": {
    "apple-productivity": {
      "args": [
        "run",
        "--project",
        "./plugins/apple-workflows/mcp",
        "apple-productivity-mcp"
      ],
      "command": "uv",
      "env": {
        "APPLE_REMINDERS_BACKEND": "${env:APPLE_REMINDERS_BACKEND}"
      }
    }
  }
}
