{
  "_comment": "Add mcpServers entries to your Gemini CLI settings",
  "mcpServers": {
    "postgres": {
      "args": [
        "postgres-mcp@0.3.0",
        "--access-mode=unrestricted"
      ],
      "command": "uvx",
      "env": {
        "DATABASE_URI": "${NEON_DATABASE_URL}"
      }
    }
  }
}
