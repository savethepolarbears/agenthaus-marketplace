{
  "_comment": "Add mcpServers entries to your ~/.codeium/windsurf/mcp_config.json",
  "mcpServers": {
    "vercel": {
      "args": [
        "-y",
        "@modelcontextprotocol/server-vercel"
      ],
      "command": "npx",
      "env": {
        "VERCEL_TOKEN": "${env:VERCEL_TOKEN}"
      }
    }
  }
}
