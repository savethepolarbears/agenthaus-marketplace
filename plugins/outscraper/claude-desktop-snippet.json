{
  "_comment": "Paste the \"mcpServers\" entries below into your claude_desktop_config.json",
  "_plugin": "outscraper",
  "_version": "1.0.0",
  "mcpServers": {
    "outscraper": {
      "args": [
        "node_modules/@outscraper/mcp-server/dist/index.js"
      ],
      "command": "node",
      "env": {
        "OUTSCRAPER_API_KEY": "${OUTSCRAPER_API_KEY}"
      }
    }
  }
}
