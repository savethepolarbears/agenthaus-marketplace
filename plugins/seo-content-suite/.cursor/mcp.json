{
  "mcpServers": {
    "markupgo": {
      "args": [
        "-y",
        "markupgo-mcp-server"
      ],
      "command": "npx",
      "env": {
        "MARKUPGO_API_KEY": "${env:MARKUPGO_API_KEY}"
      }
    },
    "neuronwriter": {
      "type": "http",
      "url": "https://app.neuronwriter.com/mcp/http"
    },
    "outscraper": {
      "args": [
        "-y",
        "outscraper-mcp@0.2.5"
      ],
      "command": "npx",
      "env": {
        "OUTSCRAPER_API_KEY": "${env:OUTSCRAPER_API_KEY}"
      }
    },
    "textfocus": {
      "args": [
        "-m",
        "textfocus_server"
      ],
      "command": "python3",
      "env": {
        "TEXTFOCUS_API_KEY": "${env:TEXTFOCUS_API_KEY}"
      }
    }
  }
}
