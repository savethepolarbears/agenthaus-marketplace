{
  "_comment": "Paste the \"mcpServers\" entries below into your claude_desktop_config.json",
  "_plugin": "markupgo",
  "_version": "1.1.0",
  "mcpServers": {
    "markupgo": {
      "args": [
        "-y",
        "markupgo-mcp-server"
      ],
      "command": "npx",
      "env": {
        "MARKUPGO_API_KEY": "${MARKUPGO_API_KEY}"
      }
    }
  }
}
