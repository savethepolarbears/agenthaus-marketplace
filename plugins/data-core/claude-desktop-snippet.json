{
  "_comment": "Paste the \"mcpServers\" entries below into your claude_desktop_config.json",
  "_plugin": "data-core",
  "_version": "1.1.0",
  "mcpServers": {
    "postgres": {
      "args": [
        "postgres-mcp@0.3.0",
        "--access-mode=unrestricted"
      ],
      "command": "uvx",
      "env": {
        "DATABASE_URI": "${NEON_DATABASE_URL}"
      }
    }
  }
}
