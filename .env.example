# AgentHaus Environment Configuration
# Copy this file to .env and fill in your credentials

# =============================================================================
# CLOUD PLATFORMS
# =============================================================================

# Cloudflare (for cloudflare-platform and devops-flow plugins)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Vercel (for vercel-deploy plugin)
VERCEL_TOKEN=

# =============================================================================
# DEVELOPMENT TOOLS
# =============================================================================

# GitHub (for github-integration and devops-flow plugins)
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=

# =============================================================================
# PRODUCTIVITY TOOLS
# =============================================================================

# Notion (for notion-workspace and knowledge-synapse plugins)
NOTION_API_KEY=
NOTION_DATABASE_ID=

# ClickUp (clickup-tasks, task-commander): official hosted MCP, OAuth only — run /mcp.
# Slack (devops-flow, qa-droid, task-commander): official hosted MCP, OAuth — run /mcp.
# Default channel ID used in notifications:
SLACK_CHANNEL=

# Gmail / Calendar / Drive (task-commander, qa-droid, knowledge-synapse) run through the
# gog CLI (see the gog-workspace plugin): `gog auth add you@example.com`. No env vars needed.
GOG_ACCOUNT=

# =============================================================================
# DATABASES
# =============================================================================

# Neon/Postgres (for neon-db and data-core plugins)
DATABASE_URL=
NEON_API_KEY=

# Agent Memory (for agent-memory plugin)
NEON_DATABASE_URL=

# =============================================================================
# GOOGLE WORKSPACE
# =============================================================================

# Google Workspace (for gog-workspace plugin)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# =============================================================================
# DOCUMENTATION
# =============================================================================

# Context7 (for context7-docs and knowledge-synapse plugins)
# No API key required - uses public API

# =============================================================================
# TESTING
# =============================================================================

# Playwright (for playwright-testing and qa-droid plugins)
# No credentials required - uses local browser

# =============================================================================
# MEDIA
# =============================================================================

# Apple Photos (for apple-photos and apple-productivity)
# No API key required - uses osxphotos CLI locally
APPLE_REMINDERS_BACKEND=

# =============================================================================
# SOCIAL MEDIA
# =============================================================================

# VistaSocial (for vistasocial-scheduler plugin)
VISTASOCIAL_API_KEY=
# Get from VistaSocial: Settings > Account Settings > Integrations > MCP link

# =============================================================================
# WORDPRESS
# =============================================================================

# WP-CLI (for wp-cli-fleet plugin)
WP_CLI_SSH_KEY=
# Optional: only needed for remote site management

# =============================================================================
# MARKETING & SEO
# =============================================================================

# Encharge (for encharge plugin)
ENCHARGE_API_KEY=

# MarkupGo (for markupgo and seo-content-suite plugins)
MARKUPGO_API_KEY=

# NeuronWriter (for neuronwriter and seo-content-suite plugins)
NEURONWRITER_API_KEY=

# Outscraper (for outscraper plugin)
OUTSCRAPER_API_KEY=

# TextFocus (for textfocus and seo-content-suite plugins)
TEXTFOCUS_API_KEY=
