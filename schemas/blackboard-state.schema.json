{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Local SQLite blackboard task readback v1",
  "description": "Structure only. src/blackboard.js enforces private DB identity, transaction/clock/lease/fence semantics; handoff.js validates envelope evidence.",
  "type": "object", "additionalProperties": false,
  "required": ["task_id", "correlation_id", "producer", "consumer", "dispatch", "status", "owner", "fence", "lease_until_ms", "result"],
  "properties": {
    "task_id": { "type": "string", "format": "uuid" }, "correlation_id": { "type": "string", "format": "uuid" },
    "producer": { "$ref": "#/definitions/actor" }, "consumer": { "$ref": "#/definitions/actor" },
    "dispatch": { "$ref": "handoff.schema.json" },
    "status": { "enum": ["pending", "in_progress", "completed", "failed"] },
    "owner": { "anyOf": [{ "type": "null" }, { "$ref": "#/definitions/actor" }] },
    "fence": { "type": "string", "pattern": "^(0|[1-9][0-9]{0,18})$" },
    "lease_until_ms": { "type": ["integer", "null"], "minimum": 0 },
    "result": { "anyOf": [{ "type": "null" }, { "$ref": "handoff.schema.json" }] }
  },
  "definitions": { "actor": { "type": "string", "pattern": "^[a-zA-Z0-9_.-]{1,64}:[a-zA-Z0-9_.-]{1,64}:[a-zA-Z0-9_.-]{1,64}$" } }
}
